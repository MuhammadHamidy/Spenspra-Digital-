# Local Docker configuration.
# Copy to .env.docker.local and adjust credentials if needed.

DB_USER=spenspra_local
DB_PASSWORD=spenspra_local_password
SSO_DB_NAME=presdig_sso
RAPOR_DB_NAME=presdig_rapor
PERPUS_DB_NAME=perpusdig
ELEARNING_DB_NAME=presdig_elearning

# Local Next.js server secret. Use a different secret in production.
JWT_SECRET=spenspra-local-jwt-secret-change-this-32-chars

SSO_PORT=3000
RAPOR_PORT=3001
PERPUS_PORT=3002
ELEARNING_PORT=3004
SSO_API_PORT=8080
RAPOR_API_PORT=8082
PERPUS_API_PORT=8083
ELEARNING_API_PORT=8084

SSO_PUBLIC_API_URL=http://localhost:8080/api
RAPOR_PUBLIC_API_URL=http://localhost:8082/api
PERPUS_PUBLIC_API_URL=http://localhost:8083/api
ELEARNING_PUBLIC_API_URL=http://localhost:8084/api
RAPOR_PUBLIC_URL=http://localhost:3001
PERPUS_PUBLIC_URL=http://localhost:3002
ELEARNING_PUBLIC_URL=http://localhost:3004
SSO_LOGIN_URL=http://localhost:3000/login
APP_PORTAL_URL=http://localhost:3000/login

# Optional integrations. Leave empty for local development.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SENDER_NAME="SMPN 1 Prambon - Presensi Digital"
WA_API_KEY=
