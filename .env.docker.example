# Spenspra Production Docker Environment
# Salin file ini menjadi .env.docker di server VPS:
# cp .env.docker.example .env.docker

# Unified Database Configuration
DB_USER=spenspra_admin
DB_PASSWORD=
SSO_DB_NAME=presdig_sso
RAPOR_DB_NAME=presdig_rapor
PERPUS_DB_NAME=perpusdig

# JWT Secret untuk sesi Next.js (Minimal 32 karakter)
JWT_SECRET=

# Port Binding Nginx (80 untuk langsung terima traffic Cloudflare/Public di VPS)
NGINX_PORT_BINDING=80

# URL Domain Publik (spenspra.com)
SSO_PUBLIC_API_URL=https://sso.spenspra.com/api
RAPOR_PUBLIC_API_URL=https://rapor.spenspra.com/api
PERPUS_PUBLIC_API_URL=https://perpus.spenspra.com/api
RAPOR_PUBLIC_URL=https://rapor.spenspra.com
PERPUS_PUBLIC_URL=https://perpus.spenspra.com
APP_PORTAL_URL=https://sso.spenspra.com/login
SSO_LOGIN_URL=https://sso.spenspra.com/login

# Konfigurasi SMTP (Email Notifikasi / Reset Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=email.sekolah@gmail.com
SMTP_PASSWORD=
SMTP_FROM=email.sekolah@gmail.com
SMTP_SENDER_NAME="SMPN 1 Prambon - Presensi Digital"

# WhatsApp API
WA_API_KEY=
