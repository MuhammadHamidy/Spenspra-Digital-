# Spenspra Production Docker Environment
# Salin file ini menjadi .env.docker di server VPS:
# cp .env.docker.example .env.docker

# Unified Database Configuration
DB_USER=spenspra_admin
DB_PASSWORD=GantiDenganPasswordDatabaseYangKuatDanUnik2026!
SSO_DB_NAME=presdig_sso
RAPOR_DB_NAME=presdig_rapor
PERPUS_DB_NAME=perpusdig

# JWT Secret untuk sesi Next.js (Minimal 32 karakter)
JWT_SECRET=GantiDenganSecretAcakPanjangMinimal32Karakter2026Spenspra!

# Port Binding Nginx (80 untuk langsung terima traffic Cloudflare/Public di VPS)
NGINX_PORT_BINDING=80

# URL Domain Publik (Ganti nama domain sesuai domain sekolah Anda di Cloudflare)
# Contoh jika domain adalah spenspra.sch.id:
SSO_PUBLIC_API_URL=https://sso.spenspra.sch.id/api
RAPOR_PUBLIC_API_URL=https://rapor.spenspra.sch.id/api
PERPUS_PUBLIC_API_URL=https://perpus.spenspra.sch.id/api
APP_PORTAL_URL=https://sso.spenspra.sch.id/login
SSO_LOGIN_URL=https://sso.spenspra.sch.id/login

# Konfigurasi SMTP (Email Notifikasi / Reset Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=email.sekolah@gmail.com
SMTP_PASSWORD=app_password_gmail_16_karakter
SMTP_FROM=email.sekolah@gmail.com
SMTP_SENDER_NAME="SMPN 1 Prambon - Presensi Digital"
